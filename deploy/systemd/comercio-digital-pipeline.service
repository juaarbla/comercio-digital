[Unit]
Description=Comercio Digital - pipeline y publicación web
Wants=network-online.target openvpn3-session@ausias.service
After=network-online.target openvpn3-session@ausias.service

[Service]
Type=oneshot
User=depinf
Group=depinf
WorkingDirectory=/home/depinf/proyectos/comercio-digital
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/home/depinf/proyectos/comercio-digital/scripts/publicar_web_diaria.sh
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
